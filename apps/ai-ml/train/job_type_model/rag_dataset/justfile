set dotenv-load := true
set shell := ["bash", "-cu"]

start-webscraper:
	docker run -d \
		--restart unless-stopped \
		-p 8080:8080 \
		--name searxng-webscraper \
		searxng/searxng:latest

delete-webscraper:
	docker stop searxng-webscraper
	docker rm -f searxng-webscraper

generate:
	doppler run -- uv run generate.py

restore:
	doppler run -- uv run restore.py

restore-and-continue:
	doppler run -- uv run restore_and_continue.py

continue:
	doppler run -- uv run continue.py
